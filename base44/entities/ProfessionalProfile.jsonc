{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "github",
        "linkedin",
        "hugging_face"
      ]
    },
    "providerAccountId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "profileUrl": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "publicRepos": {
      "type": "integer"
    },
    "followers": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "stars": {
            "type": "integer"
          }
        },
        "required": [
          "title",
          "url",
          "kind"
        ]
      }
    },
    "syncedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "provider",
    "providerAccountId",
    "displayName",
    "syncedAt"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}