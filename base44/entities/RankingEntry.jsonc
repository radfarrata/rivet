    "modelId",
    "modelLabel",
    "score",
    "evidenceStatus",
    "officialEligible",
    "computedAt"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
