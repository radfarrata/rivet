      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "taskVersionId": {
      "type": "string"
    },
    "modelVersionId": {
      "type": "string"
    },
    "methodologyVersionId": {
      "type": "string"
    },
    "methodologyVersion": {
      "type": "string"
    },
    "suiteId": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "modelLabel": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "evidenceStatus": {
      "type": "string",
