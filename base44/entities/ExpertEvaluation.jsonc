{
  "name": "ExpertEvaluation",
  "type": "object",
  "properties": {
    "traceId": {
      "type": "string"
    },
    "expertId": {
      "type": "string"
    },
    "expertName": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "confirmed_failure",
        "false_positive",
        "needs_info"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "failureType": {
      "type": "string",
      "enum": [
        "hallucination",
        "tool_misuse",
        "safety_violation",
        "non_compliance",
        "logic_error",
        "not_applicable",
        "other"
      ]
    },
    "structuredFeedback": {
      "type": "string"
    },
    "ruleDefinition": {
      "type": "string"
    },
    "resultId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "evidenceId": {
      "type": "string"
    },
    "finalScore": {
      "type": "number"
    },
    "reviewIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credentialId": {
      "type": "string"
    },
    "conflictDeclaration": {
      "type": "string"
    },
    "methodologyVersion": {
      "type": "string"
    }
  },
  "required": [
    "traceId",
    "verdict"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}