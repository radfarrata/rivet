{
  "name": "ExpertCredential",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affiliation": {
      "type": "string"
    },
    "orcid": {
      "type": "string"
    },
    "portfolioUrl": {
      "type": "string"
    },
    "evidenceNotes": {
      "type": "string",
      "maxLength": 4000
    },
    "conflictDeclaration": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "revoked"
      ]
    },
    "decisionReason": {
      "type": "string"
    },
    "verifiedBy": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "domains",
    "status",
    "conflictDeclaration"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}