{
  "name": "TestCase",
  "type": "object",
  "properties": {
    "suiteId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "expectedBehavior": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "caseType": {
      "type": "string",
      "enum": [
        "adversarial",
        "edge_case",
        "compliance",
        "regression"
      ]
    }
  },
  "required": [
    "title",
    "input"
  ]
}