{
  "name": "TestCase",
  "type": "object",
  "properties": {
    "suiteId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "expectedBehavior": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "caseType": {
      "type": "string",
      "enum": [
        "adversarial",
        "edge_case",
        "compliance",
        "regression"
      ]
    }
  },
  "required": [
    "title",
    "input"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}