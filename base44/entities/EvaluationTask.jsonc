{
  "name": "EvaluationTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "reasoning",
        "coding",
        "mathematics",
        "biology",
        "chemistry",
        "physics",
        "medicine",
        "multimodal",
        "long_context",
        "safety",
        "scientific_reasoning",
        "agentic",
        "other"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ],
      "default": "intermediate"
    },
    "evaluationCriteria": {
      "type": "string"
    },
    "evaluationType": {
      "type": "string",
      "enum": [
        "automated",
        "human",
        "hybrid"
      ],
      "default": "hybrid"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "evaluated"
      ],
      "default": "pending"
    },
    "creatorName": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "currentVersionId": {
      "type": "string"
    },
    "integrityVersion": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "prompt"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.visibility": "public"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}