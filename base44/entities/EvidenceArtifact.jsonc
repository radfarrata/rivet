{
  "name": "EvidenceArtifact",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "taskVersionId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task_snapshot",
        "model_output",
        "judge_record",
        "run_bundle"
      ]
    },
    "uri": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "previousArtifactHash": {
      "type": "string"
    },
    "mimeType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "byteSize": {
      "type": "number"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "taskVersionId",
    "kind",
    "uri",
    "sha256",
    "mimeType",
    "schemaVersion",
    "createdAt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}