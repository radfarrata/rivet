{
  "name": "SavedTask",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string"
    },
    "taskTitle": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    }
  },
  "required": [
    "taskId"
  ],
  "rls": {
