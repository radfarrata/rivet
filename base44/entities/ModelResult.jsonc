{
  "name": "ModelResult",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string"
    },
    "taskTitle": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "summary": {
      "type": "string"
    },
    "strengths": {
      "type": "string"
    },
    "weaknesses": {
      "type": "string"
    },
    "failureModes": {
      "type": "string"
    },
    "rawResponse": {
      "type": "string"
    },
    "judgedBy": {
      "type": "string",
      "default": "Rivet automated judge"
    },
    "taskVersionId": {
      "type": "string"
    },
    "evidenceId": {
      "type": "string"
    },
    "methodologyVersion": {
      "type": "string"
    },
    "evidenceStatus": {
      "type": "string",
      "enum": [
        "legacy",
        "complete",
        "incomplete"
      ]
    }
  },
  "required": [
    "taskId",
    "modelId",
    "score"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}